# =====================================================================
# DELHI SURAKSHA PATH - environment file
# ---------------------------------------------------------------------
# 1. Copy this file to ".env" in the project root:
#       Windows PowerShell :  Copy-Item .env.example .env
#       Mac / Linux        :  cp .env.example .env
# 2. Fill in ONLY the values you need.
# 3. NEVER commit .env to git (it is already in .gitignore).
#
# IMPORTANT: every feature works WITHOUT any key below.
# Twilio is optional. Without it, the SOS page shows a copy-paste
# message that you can send yourself from any phone / WhatsApp.
# =====================================================================

# ---------- OPTIONAL: Twilio SMS for the SOS button ----------
# Free trial account: https://www.twilio.com/try-twilio
# On a trial account you can only SMS verified numbers.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=      # e.g. +12025550123 (the Twilio number)
TWILIO_TO_NUMBER=        # default trusted contact, e.g. +919876543210

# ---------- Maps API Keys (provider-specific) ----------
GOOGLE_MAPS_API_KEY=
MAPS_API_KEY=  # Optional fallback / Geoapify map key

# ---------- Geocoding politeness (required by Nominatim) ----------
# Put a real contact, e.g. "delhi-suraksha-path/1.0 (your.email@example.com)"
NOMINATIM_USER_AGENT=delhi-suraksha-path/1.0 (student project)

# ---------- Database location (relative paths are from project root) ----------
DB_PATH=data/delhi_suraksha.db

# ---------- App behaviour ----------
# Set to "1" to hide the "synthetic data" warning banners (not recommended)
HIDE_SYNTHETIC_BANNER=0
